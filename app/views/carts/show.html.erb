<% content_for :title, "Shopping Cart" %>

<section class="cart-page">
  <div class="cart-heading">
    <p>Ready to check out?</p>
    <h1>Shopping Cart</h1>
  </div>

  <% if notice.present? %>
    <div class="cart-notice">
      <%= notice %>
    </div>
  <% end %>

  <% if @cart_items.any? %>
    <div class="cart-items">
      <% @cart_items.each do |cart_item| %>
        <% product = cart_item[:product] %>
        <% quantity = cart_item[:quantity] %>
        <% unit_price = cart_item[:unit_price] %>
        <% line_total = cart_item[:line_total] %>

        <article class="cart-item">
          <div class="cart-item-image-wrap">
            <div class="cart-item-image">
              <% if product.image.attached? %>
                <%= image_tag product.image, alt: product.name %>
              <% else %>
                <div class="cart-missing-image">
                  <span>Image coming soon</span>
                </div>
              <% end %>
            </div>

            <span class="cart-item-quantity-badge">
              <%= quantity %>
            </span>
          </div>

          <div class="cart-item-information">
            <h2>
              <%= link_to product.name,
                          product_path(product) %>
            </h2>

            <p class="cart-item-category">
              <%= product.categories.map(&:name).join(", ") %>
            </p>

            <div class="cart-item-controls">
              <span class="cart-quantity-label">
                Quantity
              </span>

              <%= form_with url: update_cart_item_path(product_id: product.id),
                            method: :patch,
                            local: true,
                            class: "cart-quantity-form" do %>
                <%= button_tag "-",
                               type: "submit",
                               name: "quantity",
                               value: quantity - 1,
                               disabled: quantity <= 1,
                               class: "cart-quantity-button cart-minus-button" %>

                <span class="cart-quantity-number">
                  <%= quantity %>
                </span>

                <%= button_tag "+",
                               type: "submit",
                               name: "quantity",
                               value: quantity + 1,
                               disabled: quantity >= product.stock_quantity,
                               class: "cart-quantity-button cart-plus-button" %>
              <% end %>

              <%= button_to "Remove",
                            remove_from_cart_path(product_id: product.id),
                            method: :delete,
                            class: "cart-remove-link" %>
            </div>

            <p class="cart-stock-message">
              <%= product.stock_quantity %> available
            </p>
          </div>

          <div class="cart-item-price">
            <span class="cart-unit-price">
              <%= number_to_currency(unit_price) %> each
            </span>

            <span class="cart-line-total">
              <%= number_to_currency(line_total) %> total
            </span>
          </div>
        </article>
      <% end %>
    </div>

    <div class="cart-summary">
      <div class="cart-summary-text">
        <p>Subtotal</p>

        <span>
          Taxes and shipping will be calculated during checkout.
        </span>
      </div>

      <strong>
        <%= number_to_currency(@subtotal) %>
      </strong>
    </div>

    <div class="cart-actions">
      <%= link_to "Continue Shopping",
                  root_path(anchor: "products"),
                  class: "cart-continue-button" %>
    </div>
  <% else %>
    <div class="empty-cart">
      <h2>Your cart is empty</h2>

      <p>
        Browse the store and add a product to begin your order.
      </p>

      <%= link_to "Shop Products",
                  root_path(anchor: "products"),
                  class: "cart-shop-button" %>
    </div>
  <% end %>
</section>